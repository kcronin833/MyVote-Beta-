# MyVote — environment variables
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and must NEVER be committed. Values come from Kevin (shared
# securely) or from each service's own dashboard.

# ── Supabase (database + auth) ──────────────────────────────────────────────
# URL + anon key are PUBLIC (safe to expose; protected by Row-Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SECRET — bypasses ALL Row-Level Security = full read/write to every user's
# data. Treat like a master password. Only needed for the news pipeline / admin
# server code. Do not expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ── News pipeline (paid / rate-limited — prefer your OWN keys for local dev) ─
NEWS_API_KEY=            # newsapi.org
GNEWS_API_KEY=           # gnews.io
ANTHROPIC_API_KEY=       # console.anthropic.com — powers "AI Just the Facts" (billed)
CRON_SECRET=             # shared secret protecting the /api/pipeline/* cron routes

# ── Analytics (optional for local dev) ──────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── AdSense (optional — ads only render when the publisher ID is set) ───────
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_NEWS_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=

# ── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=   # optional: auth redirect override for local dev
# VERCEL_ENV / VERCEL_URL are injected automatically by Vercel — do not set.
